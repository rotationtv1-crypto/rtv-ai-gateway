{
  "name": "rtv-ai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "vars": {
    "ENVIRONMENT": "production"
  },
  // Secrets to set via: wrangler secret put <KEY>
  // GEMINI_API_KEY
  // VENICE_API_KEY
  // CLAUDE_API_KEY
  // SUPABASE_URL
  // SUPABASE_SERVICE_KEY
  // TELEGRAM_BOT_TOKEN (livestream bot)
  // TELEGRAM_BOT_TOKEN_18 (erotica bot)
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
